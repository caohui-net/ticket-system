# Crontab配置示例
# 用于自动化维护任务
#
# 安装方法:
#   crontab -e
# 然后添加以下内容（根据实际路径调整）

# ==========================================
# 环境变量
# ==========================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=admin@yourdomain.com

# 工作目录
PROJECT_DIR=/home/caohui/projects/工单项目/backend

# ==========================================
# 数据库备份
# ==========================================

# 每天凌晨2点执行数据库备份
0 2 * * * cd $PROJECT_DIR && ./backup-database.sh >> logs/backup.log 2>&1

# 每周日凌晨3点执行完整备份（包含上传文件）
0 3 * * 0 cd $PROJECT_DIR && tar -czf backups/full_backup_$(date +\%Y\%m\%d).tar.gz uploads/ logs/ >> logs/backup.log 2>&1

# ==========================================
# 日志清理
# ==========================================

# 每天凌晨4点清理7天前的日志文件
0 4 * * * find $PROJECT_DIR/logs -name "*.log" -mtime +7 -delete

# 每周清理旧的备份文件（保留30天）
0 4 * * 1 find $PROJECT_DIR/backups -name "backup_*.sql.gz" -mtime +30 -delete

# ==========================================
# 数据库维护
# ==========================================

# 每周日凌晨4点执行数据库优化
0 4 * * 0 docker exec ticket-system-db psql -U ticketuser -d ticket_system -c "VACUUM ANALYZE;" >> logs/maintenance.log 2>&1

# ==========================================
# 健康检查和监控
# ==========================================

# 每5分钟检查服务健康状态
*/5 * * * * curl -f http://localhost:3000/health || echo "Health check failed at $(date)" >> logs/health-check.log

# 每小时检查容器状态
0 * * * * docker-compose -f $PROJECT_DIR/docker-compose.yml ps | grep -v "Up" && echo "Container issue detected at $(date)" >> logs/container-check.log

# ==========================================
# 磁盘空间检查
# ==========================================

# 每天检查磁盘空间，低于10%时发送告警
0 6 * * * df -h / | awk 'NR==2 {if (substr($5,1,length($5)-1) > 90) print "Disk usage critical: "$5}' >> logs/disk-check.log

# ==========================================
# SSL证书续期（Let's Encrypt）
# ==========================================

# 每周检查并更新SSL证书
0 5 * * 1 certbot renew --quiet --post-hook "systemctl reload nginx" >> logs/certbot.log 2>&1

# ==========================================
# Docker清理
# ==========================================

# 每周清理未使用的Docker资源
0 5 * * 0 docker system prune -af --volumes >> logs/docker-cleanup.log 2>&1

# ==========================================
# 应用重启（可选）
# ==========================================

# 每周日凌晨1点重启应用（避免内存泄漏）
# 注意：仅在确实需要时启用
# 0 1 * * 0 cd $PROJECT_DIR && docker-compose restart backend >> logs/restart.log 2>&1

# ==========================================
# 性能统计
# ==========================================

# 每小时记录资源使用情况
0 * * * * docker stats --no-stream >> logs/stats_$(date +\%Y\%m\%d).log 2>&1

# ==========================================
# 数据库连接数监控
# ==========================================

# 每30分钟检查数据库连接数
*/30 * * * * docker exec ticket-system-db psql -U ticketuser -d ticket_system -c "SELECT count(*) FROM pg_stat_activity;" >> logs/db-connections.log 2>&1

# ==========================================
# 示例：自定义业务任务
# ==========================================

# 每天凌晨5点清理过期的临时文件
# 0 5 * * * cd $PROJECT_DIR && docker-compose exec -T backend npx ts-node scripts/cleanup-temp-files.ts >> logs/cleanup.log 2>&1

# 每周一早上8点生成周报
# 0 8 * * 1 cd $PROJECT_DIR && docker-compose exec -T backend npx ts-node scripts/generate-weekly-report.ts >> logs/reports.log 2>&1

# ==========================================
# 注意事项
# ==========================================

# 1. 确保所有脚本都有可执行权限
# 2. 确保日志目录存在并有写入权限
# 3. 根据实际需求调整执行时间
# 4. 配置邮件通知（MAILTO）以接收cron任务输出
# 5. 定期检查日志文件，确保任务正常执行
# 6. 避免在高峰时段执行资源密集型任务
# 7. 测试所有定时任务后再投入生产使用

# ==========================================
# Cron时间格式说明
# ==========================================
#
# 格式: * * * * * command
#       | | | | |
#       | | | | +---- 星期 (0-7, 0和7都代表周日)
#       | | | +------ 月份 (1-12)
#       | | +-------- 日期 (1-31)
#       | +---------- 小时 (0-23)
#       +------------ 分钟 (0-59)
#
# 特殊字符:
# * - 任意值
# , - 列表 (例如: 1,3,5)
# - - 范围 (例如: 1-5)
# / - 间隔 (例如: */5)
#
# 示例:
# 0 2 * * *        每天凌晨2点
# */15 * * * *     每15分钟
# 0 9-17 * * 1-5   工作日的9点到17点每小时
# 0 0 1 * *        每月1号凌晨

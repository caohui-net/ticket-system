// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   BigInt      @id @default(autoincrement()) @map("user_id")
  username             String      @unique @db.VarChar(50)
  password             String      @db.VarChar(255)
  realName             String      @map("real_name") @db.VarChar(50)
  email                String      @unique @db.VarChar(100)
  phone                String?     @db.VarChar(20)
  department           String?     @db.VarChar(50)
  avatarUrl            String?     @map("avatar_url") @db.VarChar(255)
  status               Int         @default(1) @db.SmallInt
  failedLoginAttempts  Int         @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?   @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?   @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp          String?     @map("last_login_ip") @db.VarChar(45)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(6)

  userRoles            UserRole[]
  assignedTickets      Ticket[]   @relation("AssignedTickets")
  notifications        Notification[]
  notificationSetting  NotificationSetting?

  // 审批流程关联（方案B第一阶段新增）
  approvalSteps        ApprovalStep[]  @relation("ApprovalSteps")
  budgetsCreated       Budget[]        @relation("BudgetCreator")
  budgetsReviewed      Budget[]        @relation("BudgetReviewer")
  projectsCreated      Project[]       @relation("ProjectCreator")

  // 签证和结算关联
  visasCreated         Visa[]          @relation("VisaCreator")
  visasReviewed        Visa[]          @relation("VisaReviewer")
  settlementsCreated   Settlement[]    @relation("SettlementCreator")
  settlementsReviewed  Settlement[]    @relation("SettlementReviewer")

  // 新增字段（方案B第一阶段）
  employeeId           String?         @map("employee_id") @db.VarChar(20)  // 工号
  isExternal           Boolean         @default(false) @map("is_external")  // 是否外部用户（乙方）
  organization         String?         @db.VarChar(100)  // 所属单位（乙方）

  @@map("users")
}

model Role {
  id          BigInt      @id @default(autoincrement()) @map("role_id")
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(50)
  description String?     @db.VarChar(200)
  permissions String?     @db.Text
  isSystem    Int         @default(0) @map("is_system") @db.SmallInt
  status      Int         @default(1) @db.SmallInt
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

// 权限表
model Permission {
  id          BigInt   @id @default(autoincrement()) @map("permission_id")
  resource    String   @db.VarChar(50) // ticket, comment, user, role, statistics
  action      String   @db.VarChar(50) // create, read, update, delete, assign, close, manage, view
  code        String   @unique @db.VarChar(100) // resource:action (如 ticket:create)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// 角色权限关联表
model RolePermission {
  roleId       BigInt
  permissionId BigInt

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          BigInt    @id @default(autoincrement()) @map("user_role_id")
  userId      BigInt    @map("user_id")
  roleId      BigInt    @map("role_id")
  assignedBy  BigInt?   @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// 工单状态枚举
enum TicketStatus {
  OPEN          // 待处理
  IN_PROGRESS   // 处理中
  PENDING       // 待反馈
  RESOLVED      // 已解决
  CLOSED        // 已关闭
  CANCELLED     // 已取消
}

// 工单优先级枚举
enum TicketPriority {
  LOW           // 低
  MEDIUM        // 中
  HIGH          // 高
  URGENT        // 紧急
}

// 工单类型枚举
enum TicketType {
  ISSUE         // 故障报修
  REQUEST       // 需求申请
  CONSULTATION  // 咨询求助
  COMPLAINT     // 投诉建议
  OTHER         // 其他
}

// 工单表
model Ticket {
  id          BigInt          @id @default(autoincrement()) @map("ticket_id")
  number      Int             @unique @default(autoincrement()) // 友好的工单编号 #1, #2, #3...
  title       String          @db.VarChar(200)
  description String          @db.Text
  type        TicketType      @default(ISSUE)
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)

  // 创建者信息（JSON快照，避免外键约束）
  creatorSnapshot Json        @map("creator_snapshot")

  // 分配信息
  assigneeId  BigInt?         @map("assignee_id")
  assignedAt  DateTime?       @map("assigned_at") @db.Timestamptz(6)

  // 时间信息
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?       @map("resolved_at") @db.Timestamptz(6)
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(6)

  // 其他字段
  tags        String[]        @default([])
  locked      Boolean         @default(false) // 是否锁定（防止并发修改）
  hidden      Boolean         @default(false) // 软隐藏

  // 关联关系
  assignee    User?           @relation("AssignedTickets", fields: [assigneeId], references: [id])
  logs        TicketLog[]
  attachments TicketAttachment[]

  // 审批流程关联（方案B第一阶段新增）
  approvalFlow ApprovalFlow?
  budget       Budget?
  project      Project?

  // 签证和结算关联
  visa         Visa?
  settlement   Settlement?

  // 新增字段（方案B第一阶段）
  location     String?         @db.VarChar(200)  // 报修位置
  currentPhase Phase           @default(REPAIR) @map("current_phase")  // 当前阶段
  currentStep  Int?            @map("current_step")  // 当前步骤

  @@index([status])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([currentPhase])
  @@map("tickets")
}

// 工单日志（评论）表
model TicketLog {
  id          BigInt    @id @default(autoincrement()) @map("log_id")
  ticketId    BigInt    @map("ticket_id")
  content     String    @db.Text
  isPublic    Boolean   @default(true) @map("is_public") // 公开/内部
  isSystem    Boolean   @default(false) @map("is_system") // 是否系统日志

  // 编辑历史
  edited      Boolean   @default(false)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  previousContent String? @map("previous_content") @db.Text

  // 创建者信息（JSON快照）
  creatorSnapshot Json  @map("creator_snapshot")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_logs")
}

// 工单附件表
model TicketAttachment {
  id          BigInt    @id @default(autoincrement()) @map("attachment_id")
  ticketId    BigInt    @map("ticket_id")
  fileName    String    @map("file_name") @db.VarChar(255)
  fileSize    BigInt    @map("file_size")
  mimeType    String    @map("mime_type") @db.VarChar(100)
  filePath    String    @map("file_path") @db.VarChar(500)

  // 上传者信息（JSON快照）
  uploaderSnapshot Json @map("uploader_snapshot")

  uploadedAt  DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// 通知类型枚举
enum NotificationType {
  TICKET_CREATED        // 工单创建
  TICKET_ASSIGNED       // 工单分配
  TICKET_STATUS_CHANGED // 状态变更
  TICKET_COMMENTED      // 新评论
  MENTION               // @提及
}

// 通知表
model Notification {
  id        BigInt           @id @default(autoincrement()) @map("notification_id")
  userId    BigInt           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String           @db.Text
  link      String?          @db.VarChar(500)
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// 通知设置表
model NotificationSetting {
  id                    BigInt  @id @default(autoincrement()) @map("setting_id")
  userId                BigInt  @unique @map("user_id")

  // 应用内通知开关
  inAppEnabled          Boolean @default(true) @map("in_app_enabled")
  ticketCreated         Boolean @default(true) @map("ticket_created")
  ticketAssigned        Boolean @default(true) @map("ticket_assigned")
  ticketStatusChanged   Boolean @default(true) @map("ticket_status_changed")
  ticketCommented       Boolean @default(true) @map("ticket_commented")
  mention               Boolean @default(true)

  // 邮件通知开关
  emailEnabled          Boolean @default(false) @map("email_enabled")
  emailTicketCreated    Boolean @default(false) @map("email_ticket_created")
  emailTicketAssigned   Boolean @default(true) @map("email_ticket_assigned")
  emailTicketStatusChanged Boolean @default(false) @map("email_ticket_status_changed")
  emailTicketCommented  Boolean @default(false) @map("email_ticket_commented")

  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ============================================
// 审批流程相关表（方案B第一阶段）
// ============================================

// 审批类型枚举
enum ApprovalType {
  REPAIR_REVIEW           // 报修审核（副主任）
  BUDGET_REVIEW           // 预算审核（副主任）
  PROJECT_APPROVAL        // 立项审批（三级）
  VISA_APPROVAL_LOW       // 签证审批-低额（单级）
  VISA_APPROVAL_MEDIUM    // 签证审批-中额（两级）
  VISA_APPROVAL_HIGH      // 签证审批-高额（三级）
  SETTLEMENT_APPROVAL_LOW    // 结算审批-低额（单级）
  SETTLEMENT_APPROVAL_MEDIUM // 结算审批-中额（两级）
  SETTLEMENT_APPROVAL_HIGH   // 结算审批-高额（三级）
}

// 审批流程状态枚举
enum FlowStatus {
  PENDING     // 进行中
  APPROVED    // 已通过
  REJECTED    // 已驳回
  CANCELLED   // 已取消
}

// 审批步骤状态枚举
enum StepStatus {
  PENDING     // 待审批
  APPROVED    // 已通过
  REJECTED    // 已驳回
  SKIPPED     // 已跳过
}

// 审批步骤类型枚举（方案B第二阶段）
enum StepType {
  SEQUENTIAL   // 顺序审批（默认）
  PARALLEL     // 并行审批
  CONDITIONAL  // 条件分支
}

// 预算状态枚举
enum BudgetStatus {
  DRAFT           // 草稿
  SUBMITTED       // 已提交
  APPROVED        // 已批准
  REJECTED        // 已驳回
}

// 立项状态枚举
enum ProjectStatus {
  DRAFT           // 草稿
  PENDING         // 待审批
  APPROVED        // 已批准
  REJECTED        // 已驳回
  IN_PROGRESS     // 施工中（第二阶段）
  COMPLETED       // 已完成（第二阶段）
}

// 工单阶段枚举
enum Phase {
  REPAIR      // 报修阶段
  BUDGET      // 预算阶段
  PROJECT     // 立项阶段
  EXECUTION   // 执行阶段
  CERTIFICATE // 签证阶段（第二阶段）
  ACCEPTANCE  // 验收阶段（第二阶段）
  SETTLEMENT  // 结算阶段
  COMPLETED   // 已完成
}

// 签证类型枚举
enum VisaType {
  COST_INCREASE    // 费用增加
  DURATION_EXTEND  // 工期延长
  SCOPE_CHANGE     // 范围变更
}

// 签证状态枚举
enum VisaStatus {
  DRAFT      // 草稿
  SUBMITTED  // 已提交
  APPROVED   // 已批准
  REJECTED   // 已驳回
}

// 结算状态枚举
enum SettlementStatus {
  DRAFT      // 草稿
  SUBMITTED  // 已提交
  APPROVED   // 已批准
  REJECTED   // 已驳回
  PAID       // 已支付
}

// 审批流程表
model ApprovalFlow {
  id              BigInt         @id @default(autoincrement()) @map("approval_flow_id")
  ticketId        BigInt         @unique @map("ticket_id")
  type            ApprovalType   // REPAIR_REVIEW, BUDGET_REVIEW, PROJECT_APPROVAL
  currentStep     Int            @default(1) @map("current_step")
  totalSteps      Int            @map("total_steps")
  status          FlowStatus     @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)

  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  steps           ApprovalStep[]

  @@index([ticketId])
  @@index([status])
  @@map("approval_flows")
}

// 审批步骤表（方案B第二阶段扩展）
model ApprovalStep {
  id                BigInt         @id @default(autoincrement()) @map("approval_step_id")
  flowId            BigInt         @map("flow_id")
  stepNumber        Int            @map("step_number")  // 1,2,3...
  stepName          String         @map("step_name") @db.VarChar(100)  // "一级审核"/"二级审核"
  stepType          StepType       @default(SEQUENTIAL) @map("step_type")  // 步骤类型
  approverRole      String?        @map("approver_role") @db.VarChar(50)  // 审批角色code（顺序审批）
  approverId        BigInt?        @map("approver_id")  // 实际审批人ID（顺序审批）
  approvers         Json?          // 并行审批时的审批人列表 [userId1, userId2, ...]
  approvedBy        Json?          @map("approved_by")  // 已审批记录 [{userId, decision, comment, time}]
  requireAllApprove Boolean        @default(true) @map("require_all_approve")  // 并行审批是否需要全部通过
  condition         Json?          // 条件配置 {field: "amount", operator: ">", value: 10000}
  status            StepStatus     @default(PENDING)
  comment           String?        @db.Text  // 审批意见（顺序审批）
  approvedAt        DateTime?      @map("approved_at") @db.Timestamptz(6)
  rejectedAt        DateTime?      @map("rejected_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  flow              ApprovalFlow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  approver          User?          @relation("ApprovalSteps", fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([flowId, stepNumber], map: "unique_flow_step")
  @@index([flowId, stepNumber])
  @@index([status])
  @@index([approverRole])
  @@map("approval_steps")
}

// 预算表（简化版）
model Budget {
  id              BigInt         @id @default(autoincrement()) @map("budget_id")
  ticketId        BigInt         @unique @map("ticket_id")
  amount          Decimal        @db.Decimal(10, 2)  // 预算金额
  description     String         @db.Text  // 预算说明
  attachments     String?        @db.Text  // JSON数组，预算文件URL
  status          BudgetStatus   @default(DRAFT)
  createdBy       BigInt         @map("created_by")  // 乙方人员ID
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(6)
  reviewedBy      BigInt?        @map("reviewed_by")  // 副主任ID
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewComment   String?        @map("review_comment") @db.Text

  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  creator         User           @relation("BudgetCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  reviewer        User?          @relation("BudgetReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([status])
  @@index([createdBy])
  @@map("budgets")
}

// 立项表
model Project {
  id                  BigInt         @id @default(autoincrement()) @map("project_id")
  ticketId            BigInt         @unique @map("ticket_id")
  title               String         @db.VarChar(200)
  plannedStartDate    DateTime       @map("planned_start_date") @db.Date  // 计划开工日期
  plannedDuration     Int            @map("planned_duration")  // 计划工期(天)
  contractorName      String         @map("contractor_name") @db.VarChar(100)  // 乙方名称
  description         String?        @db.Text  // 立项说明
  status              ProjectStatus  @default(DRAFT)
  createdBy           BigInt         @map("created_by")  // 副主任/主管
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt         DateTime?      @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?      @map("approved_at") @db.Timestamptz(6)

  ticket              Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  creator             User           @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  visas               Visa[]
  settlements         Settlement[]

  @@index([ticketId])
  @@index([status])
  @@index([createdBy])
  @@map("projects")
}

// ============================================
// 签证和结算表（方案B第二阶段）
// ============================================

// 签证表（执行过程中的变更）
model Visa {
  id            BigInt      @id @default(autoincrement()) @map("visa_id")
  ticketId      BigInt      @unique @map("ticket_id")
  projectId     BigInt      @map("project_id")
  title         String      @db.VarChar(200)
  reason        String      @db.Text  // 签证原因
  changeType    VisaType    @map("change_type")  // 变更类型：费用增加、工期延长、范围变更
  originalValue Decimal?    @map("original_value") @db.Decimal(12, 2)  // 原值（费用或工期）
  changedValue  Decimal     @map("changed_value") @db.Decimal(12, 2)  // 变更后的值
  description   String      @db.Text
  attachments   String?     @db.Text  // JSON数组
  status        VisaStatus  @default(SUBMITTED)
  createdBy     BigInt      @map("created_by")
  reviewedBy    BigInt?     @map("reviewed_by")
  reviewedAt    DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  reviewComment String?     @db.VarChar(500) @map("review_comment")
  submittedAt   DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User        @relation("VisaCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  reviewer      User?       @relation("VisaReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@map("visas")
}

// 结算表
model Settlement {
  id               BigInt           @id @default(autoincrement()) @map("settlement_id")
  ticketId         BigInt           @unique @map("ticket_id")
  projectId        BigInt           @map("project_id")
  totalAmount      Decimal          @db.Decimal(12, 2) @map("total_amount")  // 结算总金额
  originalAmount   Decimal          @db.Decimal(12, 2) @map("original_amount")  // 原预算金额
  visaAmount       Decimal          @default(0) @db.Decimal(12, 2) @map("visa_amount")  // 签证增加金额
  description      String           @db.Text
  attachments      String?          @db.Text  // JSON数组（发票、验收报告等）
  status           SettlementStatus @default(SUBMITTED)
  createdBy        BigInt           @map("created_by")
  reviewedBy       BigInt?          @map("reviewed_by")
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewComment    String?          @db.VarChar(500) @map("review_comment")
  submittedAt      DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  ticket           Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User             @relation("SettlementCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  reviewer         User?            @relation("SettlementReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@map("settlements")
}

// ============================================
// 审批模板表（方案B第二阶段）
// ============================================

// 审批模板表
model ApprovalTemplate {
  id          BigInt   @id @default(autoincrement()) @map("template_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  type        String   @db.VarChar(50)  // 审批类型标识
  isActive    Boolean  @default(true) @map("is_active")
  config      Json     // 模板配置（JSON格式）
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("approval_templates")
}

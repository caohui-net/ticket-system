// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   BigInt      @id @default(autoincrement()) @map("user_id")
  username             String      @unique @db.VarChar(50)
  password             String      @db.VarChar(255)
  realName             String      @map("real_name") @db.VarChar(50)
  email                String      @unique @db.VarChar(100)
  phone                String?     @db.VarChar(20)
  department           String?     @db.VarChar(50)
  avatarUrl            String?     @map("avatar_url") @db.VarChar(255)
  status               Int         @default(1) @db.SmallInt
  failedLoginAttempts  Int         @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?   @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?   @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp          String?     @map("last_login_ip") @db.VarChar(45)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(6)

  userRoles            UserRole[]
  assignedTickets      Ticket[]   @relation("AssignedTickets")
  notifications        Notification[]
  notificationSetting  NotificationSetting?

  @@map("users")
}

model Role {
  id          BigInt      @id @default(autoincrement()) @map("role_id")
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(50)
  description String?     @db.VarChar(200)
  permissions String?     @db.Text
  isSystem    Int         @default(0) @map("is_system") @db.SmallInt
  status      Int         @default(1) @db.SmallInt
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

// 权限表
model Permission {
  id          BigInt   @id @default(autoincrement()) @map("permission_id")
  resource    String   @db.VarChar(50) // ticket, comment, user, role, statistics
  action      String   @db.VarChar(50) // create, read, update, delete, assign, close, manage, view
  code        String   @unique @db.VarChar(100) // resource:action (如 ticket:create)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// 角色权限关联表
model RolePermission {
  roleId       BigInt
  permissionId BigInt

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          BigInt    @id @default(autoincrement()) @map("user_role_id")
  userId      BigInt    @map("user_id")
  roleId      BigInt    @map("role_id")
  assignedBy  BigInt?   @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// 工单状态枚举
enum TicketStatus {
  OPEN          // 待处理
  IN_PROGRESS   // 处理中
  PENDING       // 待反馈
  RESOLVED      // 已解决
  CLOSED        // 已关闭
  CANCELLED     // 已取消
}

// 工单优先级枚举
enum TicketPriority {
  LOW           // 低
  MEDIUM        // 中
  HIGH          // 高
  URGENT        // 紧急
}

// 工单类型枚举
enum TicketType {
  ISSUE         // 故障报修
  REQUEST       // 需求申请
  CONSULTATION  // 咨询求助
  COMPLAINT     // 投诉建议
  OTHER         // 其他
}

// 工单表
model Ticket {
  id          BigInt          @id @default(autoincrement()) @map("ticket_id")
  number      Int             @unique @default(autoincrement()) // 友好的工单编号 #1, #2, #3...
  title       String          @db.VarChar(200)
  description String          @db.Text
  type        TicketType      @default(ISSUE)
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)

  // 创建者信息（JSON快照，避免外键约束）
  creatorSnapshot Json        @map("creator_snapshot")

  // 分配信息
  assigneeId  BigInt?         @map("assignee_id")
  assignedAt  DateTime?       @map("assigned_at") @db.Timestamptz(6)

  // 时间信息
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?       @map("resolved_at") @db.Timestamptz(6)
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(6)

  // 其他字段
  tags        String[]        @default([])
  locked      Boolean         @default(false) // 是否锁定（防止并发修改）
  hidden      Boolean         @default(false) // 软隐藏

  // 关联关系
  assignee    User?           @relation("AssignedTickets", fields: [assigneeId], references: [id])
  logs        TicketLog[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("tickets")
}

// 工单日志（评论）表
model TicketLog {
  id          BigInt    @id @default(autoincrement()) @map("log_id")
  ticketId    BigInt    @map("ticket_id")
  content     String    @db.Text
  isPublic    Boolean   @default(true) @map("is_public") // 公开/内部
  isSystem    Boolean   @default(false) @map("is_system") // 是否系统日志

  // 编辑历史
  edited      Boolean   @default(false)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  previousContent String? @map("previous_content") @db.Text

  // 创建者信息（JSON快照）
  creatorSnapshot Json  @map("creator_snapshot")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_logs")
}

// 工单附件表
model TicketAttachment {
  id          BigInt    @id @default(autoincrement()) @map("attachment_id")
  ticketId    BigInt    @map("ticket_id")
  fileName    String    @map("file_name") @db.VarChar(255)
  fileSize    BigInt    @map("file_size")
  mimeType    String    @map("mime_type") @db.VarChar(100)
  filePath    String    @map("file_path") @db.VarChar(500)

  // 上传者信息（JSON快照）
  uploaderSnapshot Json @map("uploader_snapshot")

  uploadedAt  DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// 通知类型枚举
enum NotificationType {
  TICKET_CREATED        // 工单创建
  TICKET_ASSIGNED       // 工单分配
  TICKET_STATUS_CHANGED // 状态变更
  TICKET_COMMENTED      // 新评论
  MENTION               // @提及
}

// 通知表
model Notification {
  id        BigInt           @id @default(autoincrement()) @map("notification_id")
  userId    BigInt           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String           @db.Text
  link      String?          @db.VarChar(500)
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// 通知设置表
model NotificationSetting {
  id                    BigInt  @id @default(autoincrement()) @map("setting_id")
  userId                BigInt  @unique @map("user_id")

  // 应用内通知开关
  inAppEnabled          Boolean @default(true) @map("in_app_enabled")
  ticketCreated         Boolean @default(true) @map("ticket_created")
  ticketAssigned        Boolean @default(true) @map("ticket_assigned")
  ticketStatusChanged   Boolean @default(true) @map("ticket_status_changed")
  ticketCommented       Boolean @default(true) @map("ticket_commented")
  mention               Boolean @default(true)

  // 邮件通知开关
  emailEnabled          Boolean @default(false) @map("email_enabled")
  emailTicketCreated    Boolean @default(false) @map("email_ticket_created")
  emailTicketAssigned   Boolean @default(true) @map("email_ticket_assigned")
  emailTicketStatusChanged Boolean @default(false) @map("email_ticket_status_changed")
  emailTicketCommented  Boolean @default(false) @map("email_ticket_commented")

  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

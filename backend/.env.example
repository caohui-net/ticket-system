# ==========================================
# 应用配置
# ==========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ==========================================
# 数据库配置
# ==========================================
# 开发环境数据库连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_system?schema=public

# 或使用Docker Compose的数据库
# DATABASE_URL=postgresql://ticket_user:ticket_pass@localhost:5432/ticket_dev?schema=public

# ==========================================
# JWT配置 (开发环境示例，生产环境必须修改)
# ==========================================
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 加密配置
# ==========================================
BCRYPT_SALT_ROUNDS=10

# ==========================================
# Redis配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# 文件上传配置
# ==========================================
# 最大文件大小 (10MB)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ==========================================
# 前端配置
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# CORS配置 (开发环境允许所有来源)
# ==========================================
CORS_ORIGIN=*

# ==========================================
# SMTP邮件配置 (可选，不配置则邮件功能不可用)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@ticketing.com

# ==========================================
# 调试配置
# ==========================================
# 是否启用Swagger API文档
SWAGGER_ENABLED=true

# 是否显示详细错误信息
SHOW_ERROR_DETAILS=true
